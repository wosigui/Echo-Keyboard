<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/accent" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:letterSpacing="0" android:layout_marginTop="24dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/title" android:textColor="@color/ink" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="4dp" android:layout_marginTop="32dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/intro" android:textColor="@color/muted" android:textSize="15sp" android:lineSpacingExtra="5dp" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card_background" android:layout_marginTop="28dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/setup_title" android:textColor="@color/ink" android:textSize="19sp" android:fontFamily="sans-serif-medium"/>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/enable" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/enable" android:textAllCaps="false" android:textSize="15sp" android:layout_marginTop="16dp" app:cornerRadius="14dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/choose" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/choose" android:textAllCaps="false" android:textSize="15sp" app:strokeColor="@color/home_outline" app:cornerRadius="14dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/playground_title" android:textColor="@color/ink" android:textSize="19sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"/>
        <EditText android:id="@+id/test_input" android:layout_width="match_parent" android:layout_height="156dp" android:background="@drawable/card_background" android:padding="20dp" android:gravity="top" android:inputType="textMultiLine|textCapSentences" android:textColor="@color/ink" android:textColorHint="@color/muted" android:textSize="16sp" android:hint="@string/try_hint" android:importantForAutofill="no"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/privacy" android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="16dp"/>
    </LinearLayout>
</ScrollView>
