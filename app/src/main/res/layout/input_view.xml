<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/keyboard_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/keyboard_background" android:id="@+id/keyboard_content">
    <LinearLayout android:id="@+id/emoji_search_bar" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:visibility="gone">
      <TextView android:id="@+id/emoji_search_query" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:textColor="@color/keyboard_text" android:textSize="15sp" android:text="@string/emoji_search_hint" />
      <TextView android:id="@+id/emoji_search_close" android:layout_width="64dp" android:layout_height="match_parent" android:gravity="center" android:text="@string/close_search" android:textColor="@color/keyboard_text" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <HorizontalScrollView android:id="@+id/emoji_results_scroll" android:layout_width="match_parent" android:layout_height="44dp" android:visibility="gone" android:scrollbars="none">
      <LinearLayout android:id="@+id/emoji_search_results" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
    </HorizontalScrollView>
    <TextView android:id="@+id/composition" android:layout_width="match_parent" android:layout_height="0dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:textColor="@color/keyboard_text" android:textSize="14sp" android:visibility="invisible" />
    <HorizontalScrollView android:id="@+id/syllables_scroll" android:layout_width="match_parent" android:layout_height="36dp" android:visibility="gone" android:scrollbars="none">
      <LinearLayout android:id="@+id/syllable_choices" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" />
    </HorizontalScrollView>
    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
      <app.echo.ime.KeyboardIconView android:id="@+id/tools" style="@style/KeyboardTool" android:tag="grid" android:contentDescription="@string/tools" />
      <app.echo.ime.KeyboardIconView android:id="@+id/layout_toggle" style="@style/KeyboardTool" android:tag="keyboard" android:contentDescription="@string/keyboard_layout" />
      <app.echo.ime.KeyboardIconView android:id="@+id/emoji" style="@style/KeyboardTool" android:tag="smile" android:contentDescription="@string/emoji" />
      <app.echo.ime.KeyboardIconView android:id="@+id/editor" style="@style/KeyboardTool" android:tag="edit" android:contentDescription="@string/text_editing" />
      <app.echo.ime.KeyboardIconView android:id="@+id/voice" style="@style/KeyboardTool" android:tag="mic" android:contentDescription="@string/voice_input" />
      <app.echo.ime.KeyboardIconView android:id="@+id/hide" style="@style/KeyboardTool" android:tag="down" android:contentDescription="@string/hide_keyboard" />
    </LinearLayout>
    <LinearLayout android:id="@+id/candidate_bar" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:visibility="gone">
      <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:scrollbars="none" android:fillViewport="true">
        <LinearLayout android:id="@+id/candidates" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
      </HorizontalScrollView>
      <app.echo.ime.KeyboardIconView android:id="@+id/expand" android:layout_width="48dp" android:layout_height="44dp" android:tag="down" android:contentDescription="@string/expand_candidates" android:clickable="true" android:focusable="true" />
    </LinearLayout>
    <app.echo.ime.EchoKeyboardView android:id="@+id/keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="0dp" android:background="@color/keyboard_background" android:keyPreviewLayout="@null" />
    <LinearLayout android:id="@+id/panel" android:layout_width="match_parent" android:layout_height="208dp" android:orientation="vertical" android:visibility="gone" android:paddingHorizontal="6dp" />
    <LinearLayout android:id="@+id/bottom_controls" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingHorizontal="24dp">
      <app.echo.ime.KeyboardIconView android:id="@+id/system_keyboard" android:layout_width="48dp" android:layout_height="40dp" android:tag="keyboard_box" android:contentDescription="@string/switch_ime" android:clickable="true" android:focusable="true" />
      <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
      <app.echo.ime.KeyboardIconView android:id="@+id/clipboard" android:layout_width="48dp" android:layout_height="40dp" android:tag="clipboard" android:contentDescription="@string/clipboard" android:clickable="true" android:focusable="true" />
    </LinearLayout>
  </LinearLayout>
  <app.echo.ime.KeyboardIconView android:id="@+id/one_hand_restore" android:layout_width="40dp" android:layout_height="56dp" android:layout_gravity="end|center_vertical" android:tag="keyboard_box" android:contentDescription="@string/restore_width" android:visibility="gone" android:clickable="true" android:focusable="true" />
</FrameLayout>
